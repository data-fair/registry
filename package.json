{
  "name": "registry",
  "version": "0.6.1",
  "description": "A simple registry for the data-fair stack containing plugin definitions and hosting archives of versions.",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=unit --max-failures=1 && playwright test --project=api --max-failures=1 && playwright test --project=e2e --max-failures=1",
    "test-unit": "playwright test --project=unit --max-failures=1",
    "test-api": "playwright test --project=api --max-failures=1",
    "test-e2e": "playwright test --project=e2e --max-failures=1",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "dev-zellij": "df-dev zellij",
    "dev:fixtures": "dotenv -- node dev/fixtures.ts",
    "build-lib-node": "tsc -p tsconfig.build.json",
    "build-types": "mkdir -p ui/src/components/vjsf && df-build-types . --vjsf-dir ui/src/components/vjsf",
    "prepare": "husky || true",
    "check-types": "tsc && npm -w ui run check-types",
    "quality": "npm run lint && npm run build-types && npm run check-types && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/registry.git"
  },
  "workspaces": [
    "ui",
    "api",
    "shared",
    "lib-node"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/registry/issues"
  },
  "homepage": "https://github.com/data-fair/registry#readme",
  "devDependencies": {
    "@commitlint/config-conventional": "^19.2.2",
    "@data-fair/lib-dev": "^0.1.0",
    "@data-fair/lib-express": "^2.0.0",
    "@data-fair/lib-node": "^3.0.0",
    "@koumoul/vjsf-compiler": "^1.2.3",
    "@playwright/test": "^1.58.2",
    "@types/busboy": "^1.5.0",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/semver": "^7.5.0",
    "commitlint": "^19.2.2",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^10.5.0",
    "eslint-plugin-vuetify": "^2.5.1",
    "husky": "^9.1.6",
    "neostandard": "^0.12.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.14.6",
    "ajv": "^8.17.1",
    "form-data": "^4.0.6",
    "tough-cookie": "^5.1.2"
  },
  "engines": {
    "node": "24"
  }
}
