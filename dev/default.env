# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5850-5899 so that they rarely collide with other local services.
DEV_HOST=localhost
# the dev servers are on loopback: allowed to the SSRF-safe http clients of the api and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5850
DEV_API_PORT=5851
# the second registry, upstream of the federation tests (npm run dev:api-upstream)
DEV_UPSTREAM_API_PORT=5852
DEV_UI_PORT=5853
DEV_UI_HMR_PORT=5854
MONGO_PORT=5855
SD_PORT=5856
MAILDEV_SMTP_PORT=5857
# no vulnerability scan by default: osv-scanner downloads its database (~200 MB) on the first scan.
# Set it to true in .env to work on the scanning (AGENTS.md "Vulnerability scanner")
SCANNING_ENABLED=false
